# Port for the local Node.js API server
PORT=3001

# Upstash Redis / Vercel KV (Required on Vercel for multi-instance MCP session sync)
# Leave empty locally to use the built-in in-memory session store
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional AI Provider API Keys (users can also input keys in the web UI)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional Local Ollama Base URL
OLLAMA_BASE_URL=http://localhost:11434/v1
